# Optional. HTTPS endpoint that receives digest signups as JSON.
# If this is unset, the site stores nothing on the server and the browser
# keeps the email in localStorage only.
# DIGEST_WEBHOOK_URL=https://example.com/hooks/ads-risk-check

# Optional canonical URL used for metadata. Vercel falls back to its own host.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
